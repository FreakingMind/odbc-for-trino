# Dummy credentials for the LOCAL test environment only (docker/compose.yml).
# They protect nothing real and must never be used for an actual deployment.

# Basic (password file) user on trino-secure.
TRINO_TEST_USER=alice
TRINO_TEST_PASSWORD=alice-password

# Keycloak admin console (http://localhost:8180).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# OAuth2 client used by trino-secure for External Auth (browser flow).
TRINO_OAUTH2_CLIENT_SECRET=trino-test-secret

# OAuth2 client used by the driver's "OIDC Client Cred Auth" method.
ODBC_CLIENT_CREDENTIALS_ID=odbc-client-credentials
ODBC_CLIENT_CREDENTIALS_SECRET=odbc-test-secret

# Shared secret between Trino nodes (required once authentication is on).
TRINO_INTERNAL_SHARED_SECRET=local-test-only-internal-communication-secret
